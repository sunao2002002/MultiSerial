<UserControl x:Class="SerialApp.Desktop.Views.GitBashPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
             mc:Ignorable="d">
    <Border x:Name="PanelBorder"
            Padding="6"
            CornerRadius="12"
            Background="{StaticResource SurfaceAltBrush}"
            BorderThickness="2"
            BorderBrush="{StaticResource SurfaceMutedBrush}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource SurfaceMutedBrush}"/>
                <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource ActivePanelBorderBrush}"/>
                        <Setter Property="Background" Value="{StaticResource ActivePanelBackgroundBrush}"/>
                        <Setter Property="BorderThickness" Value="4"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="{Binding Title}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ActivePanelBorderBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="1"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{Binding StatusMessage}"/>

                <Button Grid.Column="2"
                        Width="76"
                        Margin="0,0,8,0"
                        Padding="8,4"
                        Content="重启"
                        Command="{Binding RestartCommand}"/>

                <Button Grid.Column="3"
                        Width="76"
                        Padding="8,4"
                        Content="停止"
                        Command="{Binding StopCommand}"/>
            </Grid>

            <Border Grid.Row="1"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="{StaticResource SurfaceMutedBrush}"
                    Background="#111827"
                    ClipToBounds="True">
                <wfi:WindowsFormsHost x:Name="TerminalHost"/>
            </Border>

            <Grid Grid.Row="2" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Margin="0,0,8,0"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Git Bash"/>

                <TextBlock Grid.Column="1"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{Binding ExecutablePath}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>